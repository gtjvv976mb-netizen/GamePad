# The GamePad store program on Solana devnet. Leave empty to run in preview mode
# (purchases are simulated in the browser and clearly labeled as such).
VITE_STORE_PROGRAM_DEVNET=
# Optional: a devnet RPC endpoint. Defaults to the public https://api.devnet.solana.com,
# which is rate limited; a provider endpoint (Helius, Triton, QuickNode) is steadier.
VITE_SOLANA_RPC=
